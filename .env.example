# Required. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# The diffusion model under test. Executes plan steps.
EXECUTOR_MODEL=inception/mercury-2.5
# The model that plans and reviews. Defaults to EXECUTOR_MODEL (Mercury doing
# all three phases) — the harness's own benchmarks found this matches or beats
# an autoregressive planner/reviewer's accuracy at a fraction of the cost and
# time on its task suite. Set this to something like anthropic/claude-sonnet-5
# for work that is genuinely ambiguous or spans files in ways a small-context
# executor can't see on its own — see docs/benchmarking.md.
PLANNER_MODEL=inception/mercury-2.5

# Mercury exposes tunable reasoning: none | low | medium | high
EXECUTOR_REASONING=low
PLANNER_REASONING=high

# Optional. Powers the web_search tool; with neither set, the tool is not
# offered. SEARXNG_URL is free: scripts/searxng/up.sh runs one locally on
# http://127.0.0.1:8888. Its results are only as good as the upstream engines
# that still answer this machine (several block scripted queries; see
# docs/architecture.md). BRAVE_API_KEY is metered (brave.com/search/api) and
# used only when SEARXNG_URL is empty, unless SEARCH_BACKEND names a backend.
# With SEARCH_BACKEND=brave the key may instead live in the macOS Keychain:
#   security add-generic-password -a harness -s BraveSearch -w <key>
# fetch_url needs neither.
SEARXNG_URL=
BRAVE_API_KEY=
# searxng | brave | empty (SearXNG if SEARXNG_URL is set, else Brave)
SEARCH_BACKEND=

# Context windows, used to size the prompt budgets. The executor's sizes each
# plan step's prompt (a quarter of it); the reviewer's sizes each review chunk
# (two thirds). Leave them alone unless you point the harness at a model with a
# materially different window — a malformed value here is ignored rather than
# raising, and the defaults below are used.
MODEL_CONTEXT_TOKENS=128000
REVIEWER_CONTEXT_TOKENS=200000
